{
  "name": "zeugnix",
  "version": "0.2.0",
  "private": true,
  "description": "zeugnix.ch – Schweizer Arbeitszeugnis-Plattform mit Hash-Verifikation und Klartext-Analyse",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run copy:pdfjs",
    "dev": "next dev",
    "prebuild": "npm run test:themes && npm run test:dataapi && npm run test:auth && npm run copy:pdfjs",
    "build": "next build",
    "copy:pdfjs": "tsx scripts/copy-pdf-worker.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:hash": "tsx scripts/test-hash.ts",
    "test:signing": "tsx scripts/test-signing.ts",
    "test:domain": "tsx scripts/test-domain.ts",
    "test:client-ip": "tsx scripts/test-client-ip.ts",
    "test:link-token": "tsx scripts/test-link-token.ts",
    "test:loeschen-confirm": "tsx scripts/test-loeschen-confirm.ts",
    "test:public-origin": "tsx scripts/test-public-origin.ts",
    "test:mastervorlage": "tsx scripts/test-mastervorlage.ts",
    "test:verify-hash": "tsx scripts/test-verify-hash.ts",
    "test:signoff-binding": "tsx scripts/test-signoff-binding.ts",
    "test:signoff-binding-db": "psql -X -v ON_ERROR_STOP=1 -f scripts/test-signoff-binding.sql",
    "test:tiptap": "tsx scripts/test-tiptap.ts",
    "test:themes": "tsx scripts/test-themes.ts",
    "test:pdf-roundtrip": "tsx scripts/test-pdf-roundtrip.ts",
    "test:tasks": "tsx scripts/test-task-keywords.ts",
    "test:schlusssaetze": "tsx scripts/test-schlusssaetze.ts",
    "test:bausteine": "tsx scripts/test-bausteine-037.ts",
    "bausteine:build": "tsx scripts/build-bausteine-037.ts",
    "test:rollen": "tsx scripts/test-rollen.ts",
    "test:rollen-db": "psql -X -v ON_ERROR_STOP=1 -f scripts/test-rollen.sql",
    "test:feinrechte-db": "psql -X -v ON_ERROR_STOP=1 -f scripts/test-feinrechte.sql",
    "test:loeschen": "tsx scripts/test-loeschen.ts",
    "test:loeschen-db": "psql -X -v ON_ERROR_STOP=1 -f scripts/test-loeschen.sql",
    "render:sample": "tsx scripts/render-sample-certificate.ts",
    "test:dataapi": "tsx scripts/test-data-api-token.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:auth-db": "psql -X -v ON_ERROR_STOP=1 -f supabase/907_auth_eigen_verify.sql",
    "backfill:hash": "tsx scripts/backfill-hash.ts",
    "check:env": "node --env-file=.env scripts/check-env.mjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "postbuild": "node scripts/check-nonce-routes.mjs",
    "check:nonce": "node scripts/check-nonce-routes.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.0.0",
    "@supabase/postgrest-js": "2.108.2",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-font-family": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "clsx": "^2.1.1",
    "next": "^15.5.29",
    "pdfjs-dist": "^4.7.76",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "stripe": "^17.4.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.5.29",
    "jszip": "^3.10.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
