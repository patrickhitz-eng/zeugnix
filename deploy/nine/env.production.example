# zeugnio.ch - Umgebungsvariablen fuer die Produktion auf dem Managed Server bei nine.ch.
#
# Auf dem Server als ~/zeugnio/shared/.env ablegen und mit `chmod 600` nur fuer den
# Benutzer www-zeugnio lesbar machen. Die echten Werte stehen im Passwort-Manager - nie im
# Repository, nie in einem Chat, nie in einer E-Mail. Vor jedem Deployment prueft
# scripts/check-env.mjs diese Datei.
#
# ZWEI DINGE, DIE MAN LEICHT FALSCH MACHT:
#
# 1. NEXT_PUBLIC_* wird beim BUILD in den JavaScript-Code eingebacken, nicht zur Laufzeit
#    gelesen. Wer einen solchen Wert aendert, braucht ein neues Deployment - ein
#    `pm2 restart` bringt nichts. Alle anderen Variablen wirken nach einem Neustart.
#
# 2. Die Datei wird vor dem Build in den Release-Ordner verknuepft. Fehlt sie dort, baut
#    Next.js mit leeren Werten und die App startet, tut aber nichts Richtiges.

# --- Datenbank auf demselben Server ----------------------------------------------------
# Angelegt mit:
#   nine-manage-databases database create --database-type=postgresql --user=nmd_zeugnio nmd_zeugnio
# Sonderzeichen im Passwort URL-kodieren: @ wird %40, : wird %3A, / wird %2F, # wird %23.
# Diese Verbindung benutzen scripts/migrate.mjs und deploy/nine/db-backup.mjs. Die
# Anwendung selbst spricht NICHT direkt mit der Datenbank, sondern ueber die Daten-API.
DATABASE_URL="postgresql://nmd_zeugnio:PASSWORT@127.0.0.1:5432/nmd_zeugnio"

# --- Eigene Daten-API (PostgREST auf demselben Server) ---------------------------------
# Ist sie gesetzt, lenkt lib/db/rest-rewrite.ts alle Datenzugriffe hierhin um. Ist sie
# LEER, laeuft alles unveraendert ueber Supabase - genau so wird vor dem Cutover getestet.
# Nur 127.0.0.1: die Daten-API ist von aussen nicht erreichbar und braucht darum weder
# einen vhost noch ein Zertifikat noch CORS.
DATA_API_URL="http://127.0.0.1:3011"

# --- Supabase ---------------------------------------------------------------------------
# ACHTUNG, das ist die wichtigste Zeile dieser Datei:
#
#   NEXT_PUBLIC_SUPABASE_URL bleibt im Cutover A auf der Supabase-Adresse stehen.
#
# Sie NICHT auf eine eigene Adresse umbiegen. supabase-js leitet aus dieser einen Adresse
# alle Endpunkte ab - auch die Anmeldung - und bildet daraus zusaetzlich den Namen des
# Sitzungs-Cookies (sb-<erstes Label>-auth-token). Wer sie umstellt, schickt die Anmeldung
# ins Leere UND entwertet in derselben Sekunde stillschweigend jede bestehende Sitzung.
# Die Daten laufen ueber DATA_API_URL, die Anmeldung bleibt bis Cutover B bei Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://<projekt>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service-Role-Schluessel: umgeht die Zeilensicherheit. Niemals in eine NEXT_PUBLIC_-
# Variable, niemals ins Frontend. Nach Cutover A pruefen die Trigger in der Datenbank
# woertlich auf current_user = service_role - der Schluessel muss also die Rolle
# service_role im Token tragen, sonst scheitern Widerruf und PII-Cleanup still.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Oeffentliche Adresse ---------------------------------------------------------------
# Ohne Pfad, ohne Schraegstrich am Ende. Steht in den QR-Codes ausgestellter Zeugnisse -
# diese Adressen duerfen nie ungueltig werden, darum hier nie eine Testadresse eintragen.
NEXT_PUBLIC_SITE_URL="https://zeugnio.ch"

# --- Signatur der Zeugnisse -------------------------------------------------------------
# DIESER SCHLUESSEL WIRD NICHT ROTIERT. Er beglaubigt bereits ausgestellte Zeugnisse;
# ein neuer Schluessel macht alte Signaturen unpruefbar. Aus dem Passwort-Manager
# uebernehmen, nicht neu erzeugen. Einzeiliges Base64-verpacktes PEM ist erlaubt und hier
# das Richtige - rohes PEM hat Zeilenumbrueche und passt nicht in eine .env-Zeile.
ZEUGNIO_SIGNING_PRIVATE_KEY=""
# Optional, JSON-Objekt mit zurueckgezogenen oeffentlichen Schluesseln, damit aeltere
# Zeugnisse weiter verifizieren. Leer lassen, solange nicht rotiert wurde.
ZEUGNIO_SIGNING_PUBLIC_KEYS=""

# --- Hochgeladene Firmenlogos -----------------------------------------------------------
# Verzeichnis ausserhalb der Release-Ordner, damit ein Deployment die Logos nicht mitnimmt.
ZEUGNIO_UPLOAD_DIR="/home/www-zeugnio/zeugnio/shared/uploads"

# --- E-Mail ------------------------------------------------------------------------------
# Bis zum Wechsel auf mailomat.swiss weiterhin Resend. Im Betreff steht kein Name einer
# Mitarbeiterin oder eines Mitarbeiters mehr - die Personendaten erscheinen erst hinter
# dem Link auf zeugnio.ch, also in der Schweiz.
RESEND_API_KEY=""
EMAIL_FROM="zeugnio <noreply@zeugnio.ch>"
EMAIL_REPLY_TO="support@zeugnio.ch"

# --- Geplante Aufgaben -------------------------------------------------------------------
# Langer Zufallswert, erzeugen mit: openssl rand -base64 32
# Der Cron auf dem Server schickt ihn als Authorization-Kopfzeile an
# /api/cron/pii-cleanup. Ohne ihn antwortet die Route mit 401 - und genau das wird nach
# dem Umzug einmal geprueft.
CRON_SECRET=""

# --- Zahlungen (heute Platzhalter, Routen sind Stubs) -----------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Sicherheits-Kopfzeilen --------------------------------------------------------------
# CSP_REPORT_ONLY=1 meldet Verstoesse nur, statt zu blockieren. Nach dem Umzug einmal auf 1
# stellen, Konsole pruefen, dann wieder entfernen. In der Produktion NICHT gesetzt lassen.
# CSP_REPORT_ONLY=

# --- Sicherung ins zweite Rechenzentrum (Object Storage bei nine, RZ nine-es34) ---------
# Ohne diese Werte sichert db-backup.mjs nur lokal - und liegt dann im selben
# Rechenzentrum wie die Datenbank, was im Ernstfall kein Backup ist.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
