# ============================================================================
# zeugnix.ch – Environment Variables
# ----------------------------------------------------------------------------
# Kopieren Sie diese Datei zu .env.local und füllen Sie die Werte aus.
# Auf Vercel: Settings → Environment Variables → alle hier aufgeführten setzen.
# ============================================================================

# ---- Supabase (PFLICHT) ---------------------------------------------------
# Aus Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Service Role Key (NIEMALS im Frontend / Public-Variablen verwenden)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ---- Site (PFLICHT) -------------------------------------------------------
# Auf Vercel: https://zeugnix.ch (oder zeugnix.vercel.app während Setup)
# Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://zeugnix.ch

# ---- Resend (für Magic-Link-E-Mails der Manager-Einladungen) -------------
# Optional für MVP – im Code wird der Link aktuell zurückgegeben statt versendet
RESEND_API_KEY=re_xxx

# ---- Stripe (für Pay-per-Use von Verify und Analyse) ---------------------
# Optional für MVP – Routen sind aktuell als Stub implementiert
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- Cron-Schutz (PFLICHT für H4 PII-Cleanup) -----------------------------
# Beliebiger langer Zufallsstring. In Vercel unter Settings → Environment
# Variables setzen – Vercel Cron sendet ihn dann automatisch als
# "Authorization: Bearer <CRON_SECRET>" an /api/cron/pii-cleanup.
# Auf dem eigenen Server schickt ihn deploy/nine/cron-pii-cleanup.mjs.
CRON_SECRET=

# ---- Signatur der Zeugnisse (optional, aber einmal gesetzt: NICHT ändern) --
# Erzeugen mit: npx tsx scripts/generate-signing-key.ts
# Ohne Schlüssel läuft alles weiter, nur ohne Signatur (voller Bestandsschutz).
# ACHTUNG: Dieser Schlüssel wird NICHT rotiert und NICHT neu erzeugt – er
# beglaubigt bereits ausgestellte Zeugnisse. Einzeiliges Base64-verpacktes PEM
# ist erlaubt und hier das Richtige.
ZEUGNIO_SIGNING_PRIVATE_KEY=
# Optional, JSON { "label": "<pubPem>" }: zurückgezogene öffentliche Schlüssel,
# damit vor einer Rotation ausgestellte Zeugnisse weiterhin verifizieren.
ZEUGNIO_SIGNING_PUBLIC_KEYS=

# ---- Absender der E-Mails --------------------------------------------------
EMAIL_FROM="zeugnio <noreply@zeugnio.ch>"
EMAIL_REPLY_TO=support@zeugnio.ch

# ---- Sicherheitsheader (nur für eine Messung) ------------------------------
# CSP_REPORT_ONLY=1 meldet Verstösse nur, statt zu blockieren. In der Produktion
# nicht gesetzt lassen.
# CSP_REPORT_ONLY=

# ============================================================================
# Ab hier: nur auf dem eigenen Server bei nine.ch nötig, nicht auf Vercel.
# Vollständig kommentierte Vorlage: deploy/nine/env.production.example
# ============================================================================

# ---- Datenbank auf derselben Maschine -------------------------------------
# Brauchen scripts/migrate.mjs und deploy/nine/db-backup.mjs. Die Anwendung
# selbst spricht nicht direkt mit der Datenbank, sondern über DATA_API_URL.
DATABASE_URL=postgresql://nmd_zeugnio:PASSWORT@127.0.0.1:5432/nmd_zeugnio

# ---- Eigene Daten-API (PostgREST) -----------------------------------------
# Ist sie gesetzt, lenkt lib/db/rest-rewrite.ts alle Datenzugriffe hierhin um;
# die Anmeldung bleibt bei Supabase. Ist sie LEER, läuft alles unverändert.
# Nur 127.0.0.1 – die Daten-API darf nie ins Internet.
#
# NEXT_PUBLIC_SUPABASE_URL dabei NICHT umbiegen: supabase-js leitet daraus auch
# die Anmelde-Endpunkte UND den Namen des Sitzungs-Cookies ab. Näheres in
# lib/db/rest-rewrite.ts; scripts/check-env.mjs bricht ab, wenn es passiert.
DATA_API_URL=

# ---- Hochgeladene Firmenlogos ---------------------------------------------
# Verzeichnis ausserhalb der Release-Ordner, sonst nimmt das nächste Deployment
# die Logos mit. Lokal genügt es, die Variable weglassen (dann ./.uploads).
ZEUGNIO_UPLOAD_DIR=

# ---- Sicherung ins zweite Rechenzentrum (Object Storage bei nine) ---------
# Halb gesetzt heisst: die Sicherung scheitert jede Nacht, und niemand merkt es.
# check-env.mjs bricht darum bei unvollständiger Angabe ab.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
